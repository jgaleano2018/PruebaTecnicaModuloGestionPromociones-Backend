# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080

# Database Configuration (Microsoft SQL Server)
# Opción 1: Autenticación de SQL Server estándar (usuario sa)
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_strong_password_here
DB_NAME=PromocionesDB
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Opción 2: Autenticación de Windows (NTLM / Integrada / Named Instance)
# Descomentar y ajustar las siguientes variables para usar Autenticación de Windows:
# DB_USE_WINDOWS_AUTH=true
# DB_DOMAIN=MI_DOMINIO_O_EQUIPO
# DB_USER=mi_usuario_windows
# DB_PASSWORD=mi_password_windows
# DB_INSTANCE_NAME=SQLEXPRESS